{
  "expo": {
    "name": "Città di Spoltore",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.formazionicalcio.b5wv7o",
      "infoPlist": {
        "NSCameraUsageDescription": "Scatta le foto dei giocatori della rosa",
        "NSPhotoLibraryUsageDescription": "Scegli le foto dei giocatori dalla galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2A0A12"
      },
      "package": "com.emergent.formazionicalcio.b5wv7o",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7A1E2E"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Scegli le foto dei giocatori dalla galleria",
          "cameraPermission": "Scatta le foto dei giocatori della rosa"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}